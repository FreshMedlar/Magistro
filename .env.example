# Magistro App — Environment Example
# Copy to .env.local for local development (never commit .env.local or auth.json).

# Separate Magistro Token Proxy Base URL (defaults to http://localhost:8000/v1)
MAGISTRO_API_BASE_URL=http://localhost:8000/v1

# Your personal user token issued by the Magistro billing dashboard (never hardcode)
MAGISTRO_API_KEY=
